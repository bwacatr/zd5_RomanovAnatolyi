<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             
             x:Class="zd4_Romanov.welcome">
    <ContentPage.Resources>
        <StyleSheetExtension Source="/loginCSS.css"/>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <Grid Padding="30, 80" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                
            </Grid.RowDefinitions>
            
            
            <StackLayout Grid.Row="0" VerticalOptions="Center">
                
            </StackLayout>
            
            <StackLayout Grid.Row="1" VerticalOptions="Center">
                <Label  x:Name="welcomeLabel" FontAttributes="Bold" FontSize="Large"/>
                <Label Text="Пролистните направо"/>
            </StackLayout>
            
            <StackLayout Grid.Row="2" VerticalOptions="Center">
                
            </StackLayout>




        </Grid>
    </ContentPage.Content>
</ContentPage>